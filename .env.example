# =====================================================================
# ApexVault Online Banking System - Environment Configuration
# Copy this file to .env and adjust values to match your local environment.
# =====================================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bank_db
DB_USERNAME=root

# MySQL Password:
# - Option 1: Put your MySQL root password here (e.g. DB_PASSWORD=mySecret123)
# - Option 2: Leave blank or set as your_mysql_password_here to be prompted securely at startup
DB_PASSWORD=your_mysql_password_here

DB_URL=jdbc:mysql://localhost:3306/bank_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Spring Boot Server Configuration
SERVER_PORT=8080
JPA_DDL_AUTO=update
SEED_DEMO_DATA=true

# Security & JWT Configuration
# 256-bit secret key for HMAC-SHA256 signature
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api
